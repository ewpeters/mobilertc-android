<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="8dp">

    <Spinner
        android:id="@+id/spinner"
        android:layout_width="0dp"
        android:layout_height="24dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/mask_circle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/spinner"
        android:layout_marginTop="16dp"
        android:padding="4dp">

        <EditText
            android:id="@+id/textView1"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:hint="cx for circle"
            style="@style/ZMEditText"
            android:inputType="numberDecimal"/>

        <View
            android:id="@+id/line1"
            android:layout_width="match_parent"
            android:layout_height="@dimen/line_height"
            android:background="@color/line_color"
            app:layout_constraintTop_toBottomOf="@+id/tvName" />

        <EditText
            android:id="@+id/textView2"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:hint="cy for circle"
            style="@style/ZMEditText"
            android:layout_marginTop="8dp"
            android:inputType="numberDecimal"/>

        <View
            android:id="@+id/line2"
            android:layout_width="match_parent"
            android:layout_height="@dimen/line_height"
            android:background="@color/line_color"
            app:layout_constraintTop_toBottomOf="@+id/tvName" />

        <EditText
            android:id="@+id/textView3"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:hint="radius for circle"
            style="@style/ZMEditText"
            android:layout_marginTop="8dp"
            android:inputType="numberDecimal"/>

        <View
            android:id="@+id/line3"
            android:layout_width="match_parent"
            android:layout_height="@dimen/line_height"
            android:background="@color/line_color"
            app:layout_constraintTop_toBottomOf="@+id/tvName" />

        <EditText
            android:id="@+id/textView4"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:hint="radius for circle"
            style="@style/ZMEditText"
            android:layout_marginTop="8dp"
            android:inputType="numberDecimal"/>

        <View
            android:id="@+id/line4"
            android:layout_width="match_parent"
            android:layout_height="@dimen/line_height"
            android:background="@color/line_color"
            app:layout_constraintTop_toBottomOf="@+id/tvName" />
    </LinearLayout>

    <Spinner
        android:id="@+id/spinner2"
        android:layout_width="0dp"
        android:layout_height="24dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mask_circle"
        android:layout_marginTop="24dp"/>

    <LinearLayout
        android:id="@+id/mask_circle2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/spinner2"
        android:layout_marginTop="16dp"
        android:padding="4dp">

        <EditText
            android:id="@+id/textView21"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:hint="cx for circle"
            style="@style/ZMEditText"
            android:inputType="numberDecimal"/>

        <View
            android:id="@+id/line21"
            android:layout_width="match_parent"
            android:layout_height="@dimen/line_height"
            android:background="@color/line_color"
            app:layout_constraintTop_toBottomOf="@+id/tvName" />

        <EditText
            android:id="@+id/textView22"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:hint="cy for circle"
            style="@style/ZMEditText"
            android:layout_marginTop="8dp"
            android:inputType="numberDecimal"/>

        <View
            android:id="@+id/line22"
            android:layout_width="match_parent"
            android:layout_height="@dimen/line_height"
            android:background="@color/line_color"
            app:layout_constraintTop_toBottomOf="@+id/tvName" />

        <EditText
            android:id="@+id/textView23"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:hint="radius for circle"
            style="@style/ZMEditText"
            android:layout_marginTop="8dp"
            android:inputType="numberDecimal"/>

        <View
            android:id="@+id/line23"
            android:layout_width="match_parent"
            android:layout_height="@dimen/line_height"
            android:background="@color/line_color"
            app:layout_constraintTop_toBottomOf="@+id/tvName" />

        <EditText
            android:id="@+id/textView24"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:hint="radius for circle"
            style="@style/ZMEditText"
            android:layout_marginTop="8dp"
            android:inputType="numberDecimal"/>

        <View
            android:id="@+id/line24"
            android:layout_width="match_parent"
            android:layout_height="@dimen/line_height"
            android:background="@color/line_color"
            app:layout_constraintTop_toBottomOf="@+id/tvName" />
    </LinearLayout>

    <TextView
        android:id="@+id/confirm_button"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:textSize="12sp"
        android:text="Use Mask"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:gravity="center"
        android:background="@color/blue_normal"/>

</androidx.constraintlayout.widget.ConstraintLayout>